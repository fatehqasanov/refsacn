rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(resourceData) {
      return isSignedIn() && request.auth.uid == resourceData.ownerId;
    }

    function isValidReference(data) {
      return data.keys().hasAll(['ownerId', 'projectId', 'projectName', 'note', 'colorHex', 'rating', 'status', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['ownerId', 'projectId', 'projectName', 'note', 'colorHex', 'rating', 'status', 'createdAt', 'updatedAt'])
        && data.ownerId is string
        && data.projectId is string
        && data.projectName is string
        && data.note is string
        && data.note.size() > 0
        && data.note.size() <= 200
        && data.colorHex is string
        && data.rating is int
        && data.rating >= 1
        && data.rating <= 5
        && data.status in ['active', 'archived'];
    }

    // Main collection: references
    match /references/{id} {
      allow read, delete: if isOwner(resource.data);

      allow create: if isSignedIn()
        && request.resource.data.ownerId == request.auth.uid
        && isValidReference(request.resource.data)
        && request.resource.data.createdAt == request.time;

      allow update: if isOwner(resource.data)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && isValidReference(request.resource.data)
        && request.resource.data.updatedAt == request.time;
    }

    // Reference collection: projects (read-only for signed-in users)
    match /projects/{id} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // User profiles collection
    match /users/{id} {
      allow read, write: if isSignedIn() && request.auth.uid == id;
    }
  }
}